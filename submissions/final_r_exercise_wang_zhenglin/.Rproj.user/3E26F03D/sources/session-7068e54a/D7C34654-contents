library('tidyverse')
data = read_csv('gapminder.csv')

# Example 1
data |>
  filter(year == 2007) |>
  ggplot() +
  geom_point(aes(x = gdpPercap, y = lifeExp, col = continent),
             size = 1, alpha = 0.9) +
  labs(
    title = "Life expectancy and GDP per person in 2007",
    x = "GDP per person",
    y = "Life expectancy (years)",
    color = "Continent"
  ) +
  theme_minimal()

# Example 2
library('ggthemes')

data |>
  filter(year == 2007) |>
  group_by(continent) |>
  summarize(pop = sum(pop)) |>
  ggplot(aes(x = reorder(continent, -pop), y = pop)) +
  geom_col(fill = "gray") +
  labs(
    title = "Total Population by continent in 2007",
    x = "Continent",
    y = "Population (billions)"
  ) +
  theme_wsj() + 
  theme(plot.title = element_text(size = 18))

# Example 3
data |> filter(year == 2007) |> ggplot() +
  geom_point(aes(x = gdpPercap, y = lifeExp, size = pop,
                 col = continent), alpha = 0.9, size = 1) +
  facet_wrap(~continent) +
  labs(
    title = "Life Expectancy vs. GDP per Capita (2007)",
    subtitle = "Point size reflects population",
    x = "GDP per capita", y = "Life expectancy"
  ) +
  theme_minimal() +
  theme(legend.position = "bottom")

# Example 4
gapminder07_grouped <- data |>
  filter(year == 2007) |>
  mutate(life_exp_bracket = case_when(
    lifeExp < 50 ~ "Under 50",
    lifeExp < 60 ~ "50–60",
    lifeExp < 65 ~ "60–65",
    lifeExp < 70 ~ "65–70",
    lifeExp < 75 ~ "70–75",
    TRUE         ~ "75+"
  )) |>
  mutate(life_exp_bracket = factor(life_exp_bracket,
                                   levels = c("Under 50", "50–60", "60–65", "65–70", "70–75", "75+"))) |>
  group_by(continent, life_exp_bracket) |>
  summarize(pop = sum(pop))

head(gapminder07_grouped, 3)

gapminder07_grouped |>
  ggplot(aes(x = reorder(continent, -pop, sum), y = pop, fill = life_exp_bracket)) +
  geom_col(position = "dodge") +
  scale_y_continuous(labels = scales::label_comma()) +
  scale_fill_brewer(palette = "Blues") + 
  labs(
    title = "Africa Trails, Europe and Oceania Lead in Life Expectancy",
    subtitle = "Population by continent, broken out by life expectancy group (2007)",
    x = NULL, y = "Population", fill = "Life Expectancy"
  ) +
  theme_minimal() +
  theme(legend.position = "top", plot.title = element_text(face = "bold"))





